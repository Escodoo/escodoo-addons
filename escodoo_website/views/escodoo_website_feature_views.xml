<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="escodoo_website_feature_view_list" model="ir.ui.view">
        <field name="name">escodoo.website.feature.list</field>
        <field name="model">escodoo.website.feature</field>
        <field name="arch" type="xml">
            <list string="Features" editable="bottom">
                <field name="sequence" widget="handle" />
                <field name="category_id" />
                <field name="name" />
                <field name="community_level" />
                <field name="oca_level" />
                <field name="enterprise_level" />
                <field name="oca_module_names" optional="show" />
                <field name="odoo_version" optional="hide" />
                <field name="closes_gap" optional="hide" />
                <field name="matches_enterprise" optional="hide" />
            </list>
        </field>
    </record>
    <record id="escodoo_website_feature_view_form" model="ir.ui.view">
        <field name="name">escodoo.website.feature.form</field>
        <field name="model">escodoo.website.feature</field>
        <field name="arch" type="xml">
            <form string="Feature">
                <sheet>
                    <group>
                        <group>
                            <field name="name" />
                            <field name="category_id" />
                            <field name="segment_ids" widget="many2many_tags" />
                            <field name="odoo_version" />
                            <field name="active" invisible="1" />
                        </group>
                        <group string="Coverage">
                            <field name="community_level" />
                            <field name="oca_level" />
                            <field name="enterprise_level" />
                            <field name="closes_gap" readonly="1" />
                            <field name="matches_enterprise" readonly="1" />
                        </group>
                    </group>
                    <group string="Evidence">
                        <field name="oca_module_names" />
                        <field name="oca_repo_url" widget="url" />
                        <field name="note" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="escodoo_website_feature_view_search" model="ir.ui.view">
        <field name="name">escodoo.website.feature.search</field>
        <field name="model">escodoo.website.feature</field>
        <field name="arch" type="xml">
            <search string="Features">
                <field name="name" />
                <field name="oca_module_names" />
                <filter
                    name="filter_closes_gap"
                    string="OCA closes the gap"
                    domain="[('closes_gap', '=', True)]"
                />
                <filter
                    name="filter_matches_enterprise"
                    string="Matches Enterprise"
                    domain="[('matches_enterprise', '=', True)]"
                />
                <separator />
                <filter
                    name="filter_needs_review"
                    string="Not covered by OCA"
                    domain="[('oca_level', '=', 'none')]"
                />
                <group expand="0" string="Group By">
                    <filter
                        name="group_category"
                        string="Category"
                        context="{'group_by': 'category_id'}"
                    />
                </group>
            </search>
        </field>
    </record>
    <record id="escodoo_website_feature_action" model="ir.actions.act_window">
        <field name="name">Features</field>
        <field name="res_model">escodoo.website.feature</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_group_category': 1}</field>
    </record>
    <record id="escodoo_website_feature_category_view_list" model="ir.ui.view">
        <field name="name">escodoo.website.feature.category.list</field>
        <field name="model">escodoo.website.feature.category</field>
        <field name="arch" type="xml">
            <list string="Categories" editable="bottom">
                <field name="sequence" widget="handle" />
                <field name="name" />
                <field name="feature_count" string="Features" />
            </list>
        </field>
    </record>
    <record id="escodoo_website_feature_category_action" model="ir.actions.act_window">
        <field name="name">Feature Categories</field>
        <field name="res_model">escodoo.website.feature.category</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="escodoo_website_feature_segment_view_list" model="ir.ui.view">
        <field name="name">escodoo.website.feature.segment.list</field>
        <field name="model">escodoo.website.feature.segment</field>
        <field name="arch" type="xml">
            <list string="Segments" editable="bottom">
                <field name="sequence" widget="handle" />
                <field name="name" />
                <field name="page_url" />
            </list>
        </field>
    </record>
    <record id="escodoo_website_feature_segment_action" model="ir.actions.act_window">
        <field name="name">Feature Segments</field>
        <field name="res_model">escodoo.website.feature.segment</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem
        id="menu_escodoo_website_feature_root"
        name="Feature Map"
        parent="website.menu_website_configuration"
        sequence="80"
    />
    <menuitem
        id="menu_escodoo_website_feature"
        parent="menu_escodoo_website_feature_root"
        action="escodoo_website_feature_action"
        sequence="10"
    />
    <menuitem
        id="menu_escodoo_website_feature_category"
        parent="menu_escodoo_website_feature_root"
        action="escodoo_website_feature_category_action"
        sequence="20"
    />
    <menuitem
        id="menu_escodoo_website_feature_segment"
        parent="menu_escodoo_website_feature_root"
        action="escodoo_website_feature_segment_action"
        sequence="30"
    />
</odoo>
