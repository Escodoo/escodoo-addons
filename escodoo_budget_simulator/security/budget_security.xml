<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data noupdate="1">
        <!-- Categories -->
        <record id="module_category_budget" model="ir.module.category">
            <field name="name">Budget Simulator</field>
            <field name="description">Budget Simulator Module</field>
            <field name="sequence">50</field>
        </record>

        <!-- Groups -->
        <record id="group_budget_user" model="res.groups">
            <field name="name">Budget User</field>
            <field name="category_id" ref="module_category_budget" />
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]" />
        </record>

        <record id="group_budget_manager" model="res.groups">
            <field name="name">Budget Manager</field>
            <field name="category_id" ref="module_category_budget" />
            <field name="implied_ids" eval="[(4, ref('group_budget_user'))]" />
            <field
                name="users"
                eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"
            />
        </record>

        <!-- Record Rules -->
        <record id="budget_simulation_user_rule" model="ir.rule">
            <field name="name">Budget Simulation: User Access</field>
            <field name="model_id" ref="model_budget_simulation" />
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_budget_user'))]" />
        </record>

        <record id="budget_template_user_rule" model="ir.rule">
            <field name="name">Budget Template: User Access</field>
            <field name="model_id" ref="model_budget_template" />
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_budget_user'))]" />
        </record>

        <record id="budget_integration_user_rule" model="ir.rule">
            <field name="name">Budget Integration: User Access</field>
            <field name="model_id" ref="model_budget_integration" />
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_budget_user'))]" />
        </record>

        <record id="budget_module_user_rule" model="ir.rule">
            <field name="name">Budget Module: User Access</field>
            <field name="model_id" ref="model_budget_module" />
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_budget_user'))]" />
        </record>
    </data>
</odoo>
