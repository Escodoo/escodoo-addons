    </record>

    <record id="module_hr_timesheet" model="budget.module">
        <field name="name">Timesheets</field>
        <field name="code">hr_timesheet</field>
        <field name="default_hours">15.0</field>
        <field
            name="description"
        >Timesheets Module - Control of hours worked, time tracking in projects and activities.</field>
    </record>

    <record id="module_hr_payroll" model="budget.module">
        <field name="name">Payroll</field>
        <field name="code">hr_payroll</field>
        <field name="default_hours">35.0</field>
        <field
            name="description"
        >Payroll Module - Payroll calculation, benefits, discounts and payslip generation.</field>
    </record>

    <record id="module_fleet" model="budget.module">
        <field name="name">Fleet</field>
        <field name="code">fleet</field>
        <field name="default_hours">18.0</field>
        <field
            name="description"
        >Fleet Module - Vehicle fleet management, maintenance, fuel and vehicle cost control.</field>
    </record>

    <record id="module_maintenance" model="budget.module">
        <field name="name">Maintenance</field>
        <field name="code">maintenance</field>
        <field name="default_hours">20.0</field>
        <field
            name="description"
        >Maintenance Module - Preventive and corrective maintenance management of equipment and assets.</field>
    </record>

    <record id="module_l10n_br_account" model="budget.module">
        <field name="name">Brazilian Accounting</field>
        <field name="code">l10n_br_account</field>
        <field name="default_hours">30.0</field>
        <field
            name="description"
        >Brazilian Accounting Module - Accounting localization for Brazil, including Brazilian chart of accounts and accounting reports.</field>
    </record>

    <record id="module_l10n_br_nfe" model="budget.module">
        <field name="name">Brazilian NFe</field>
        <field name="code">l10n_br_nfe</field>
        <field name="default_hours">45.0</field>
        <field
            name="description"
        >Brazilian NFe Module - Electronic Invoice issuance and management integrated with the Brazilian fiscal module.</field>
    </record>

    <!-- Lines -->
    <record id="line_discovery" model="budget.line">
        <field name="name">Discovery and Requirements Analysis</field>
        <field name="code">discovery_analysis</field>
        <field name="category">discovery</field>
        <field name="default_hours">40.0</field>
        <field
            name="description"
        >Initial meetings, requirements gathering, and analysis.</field>
        <field name="sequence">10</field>
    </record>

    <record id="line_config" model="budget.line">
        <field name="name">System Configuration</field>
        <field name="code">system_config</field>
        <field name="category">config</field>
        <field name="default_hours">60.0</field>
        <field name="description">System setup and configuration.</field>
        <field name="sequence">20</field>
    </record>

    <record id="line_dev" model="budget.line">
        <field name="name">Custom Development</field>
        <field name="code">custom_dev</field>
        <field name="category">dev</field>
        <field name="default_hours">80.0</field>
        <field name="description">Customizations and specific developments.</field>
        <field name="sequence">30</field>
    </record>

    <record id="line_migration" model="budget.line">
        <field name="name">Data Migration</field>
        <field name="code">data_migration</field>
        <field name="category">migration</field>
        <field name="default_hours">50.0</field>
        <field name="description">Data migration from legacy systems.</field>
        <field name="sequence">40</field>
