        <field name="name">User Training</field>
        <field name="code">user_training</field>
        <field name="category">train</field>
        <field name="default_hours">30.0</field>
        <field name="description">Training sessions for end users.</field>
        <field name="sequence">50</field>
    </record>

    <record id="line_support" model="budget.line">
        <field name="name">Go-Live Support</field>
        <field name="code">go_live_support</field>
        <field name="category">support</field>
        <field name="default_hours">40.0</field>
        <field name="description">Support during go-live period.</field>
        <field name="sequence">60</field>
    </record>

    <!-- Template -->
    <record id="template_standard_implementation" model="budget.template">
        <field name="name">Standard Odoo Implementation</field>
        <field
            name="description"
        >Standard template for a typical Odoo implementation with Brazilian fiscal requirements.</field>
        <field name="complexity">medium</field>
        <field name="users_qty">10</field>
        <field name="company_qty">1</field>
        <field name="state">confirmed</field>
        <field
            name="integration_line_ids"
            eval="[
                (0, 0, {'integration_id': ref('integration_nfe')}),
                (0, 0, {'integration_id': ref('integration_nfse')}),
            ]"
        />
        <field
            name="module_line_ids"
            eval="[
                (0, 0, {'module_id': ref('module_sale')}),
                (0, 0, {'module_id': ref('module_stock')}),
                (0, 0, {'module_id': ref('module_account')}),
                (0, 0, {'module_id': ref('module_l10n_br_fiscal')}),
            ]"
        />
    </record>

    <!-- General Activities -->
    <record id="template_line_discovery" model="budget.template.line">
        <field name="template_id" ref="template_standard_implementation" />
        <field name="line_id" ref="line_discovery" />
        <field name="sequence">10</field>
    </record>

    <record id="template_line_config" model="budget.template.line">
        <field name="template_id" ref="template_standard_implementation" />
        <field name="line_id" ref="line_config" />
