                (0, 0, {'module_id': ref('module_mrp_workorder')}),
                (0, 0, {'module_id': ref('module_account')}),
                (0, 0, {'module_id': ref('module_l10n_br_fiscal')}),
                (0, 0, {'module_id': ref('module_hr')}),
