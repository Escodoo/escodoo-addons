            name="description"
        >Project Module - Project management, tasks, timesheets and project progress tracking.</field>
    </record>

    <record id="module_hr" model="budget.module">
        <field name="name">Human Resources</field>
        <field name="code">hr</field>
        <field name="default_hours">20.0</field>
        <field
            name="description"
        >Human Resources Module - Employee management, departments, positions, performance evaluations and organizational structure.</field>
    </record>

    <record id="module_purchase" model="budget.module">
        <field name="name">Purchase</field>
        <field name="code">purchase</field>
        <field name="default_hours">22.0</field>
        <field
            name="description"
        >Purchase Module - Complete purchase process management, including requisitions, purchase orders, goods receipt and supplier control.</field>
    </record>

    <record id="module_mrp" model="budget.module">
        <field name="name">Manufacturing</field>
        <field name="code">mrp</field>
        <field name="default_hours">40.0</field>
        <field
            name="description"
        >Manufacturing Module - Production management, manufacturing orders, production routings, bills of materials (BOM) and production control.</field>
    </record>

    <record id="module_mrp_workorder" model="budget.module">
        <field name="name">Manufacturing Work Orders</field>
        <field name="code">mrp_workorder</field>
        <field name="default_hours">25.0</field>
        <field
            name="description"
        >Manufacturing Work Orders Module - Detailed control of work orders in production, including machine times and operators.</field>
    </record>

    <record id="module_website" model="budget.module">
        <field name="name">Website</field>
        <field name="code">website</field>
        <field name="default_hours">30.0</field>
        <field
            name="description"
        >Website Module - Creation and management of websites, pages, blogs and web content integrated with Odoo.</field>
    </record>

    <record id="module_website_sale" model="budget.module">
        <field name="name">eCommerce</field>
        <field name="code">website_sale</field>
        <field name="default_hours">35.0</field>
        <field
            name="description"
        >eCommerce Module - Complete online store integrated with the sales module, with shopping cart, checkout and online product management.</field>
    </record>

    <record id="module_crm" model="budget.module">
        <field name="name">CRM</field>
        <field name="code">crm</field>
        <field name="default_hours">25.0</field>
        <field
            name="description"
        >CRM Module - Customer relationship management, leads, opportunities, sales pipeline and commercial activities.</field>
    </record>

    <record id="module_helpdesk" model="budget.module">
        <field name="name">Helpdesk</field>
        <field name="code">helpdesk</field>
        <field name="default_hours">20.0</field>
        <field
            name="description"
