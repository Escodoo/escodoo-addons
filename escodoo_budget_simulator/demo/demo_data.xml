        />
        <field
            name="module_line_ids"
            eval="[
                (0, 0, {'module_id': ref('module_sale')}),
                (0, 0, {'module_id': ref('module_stock')}),
                (0, 0, {'module_id': ref('module_account')}),
                (0, 0, {'module_id': ref('module_l10n_br_fiscal')}),
                (0, 0, {'module_id': ref('module_website')}),
                (0, 0, {'module_id': ref('module_website_sale')}),
                (0, 0, {'module_id': ref('module_crm')}),
            ]"
        />
    </record>

    <!-- Template 2 Lines -->
    <record id="template2_line_discovery" model="budget.template.line">
        <field name="template_id" ref="template_ecommerce_multicompany" />
