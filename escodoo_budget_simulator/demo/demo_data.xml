    <record id="template_ecommerce_multicompany" model="budget.template">
        <field name="name">E-commerce Multi-Company Implementation</field>
        <field
            name="description"
        >Template for e-commerce implementations with multiple companies, including online store, payment integrations, and Brazilian fiscal requirements.</field>
        <field name="complexity">high</field>
        <field name="users_qty">25</field>
        <field name="company_qty">3</field>
        <field name="state">confirmed</field>
        <field
            name="integration_line_ids"
            eval="[
                (0, 0, {'integration_id': ref('integration_nfe')}),
                (0, 0, {'integration_id': ref('integration_nfse')}),
                (0, 0, {'integration_id': ref('integration_cnab_receivable')}),
                (0, 0, {'integration_id': ref('integration_cte')}),
                (0, 0, {'integration_id': ref('integration_mdfe')}),
