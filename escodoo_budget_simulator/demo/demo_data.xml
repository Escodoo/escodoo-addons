<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <!-- Integrations -->
    <record id="integration_nfe" model="budget.integration">
        <field name="name">NFe</field>
        <field name="code">nfe</field>
        <field name="default_hours">40.0</field>
        <field
            name="description"
        >Electronic Invoice - Integration with SEFAZ for issuing and receiving product invoices.</field>
    </record>

    <record id="integration_nfse" model="budget.integration">
        <field name="name">NFS-e</field>
        <field name="code">nfse</field>
        <field name="default_hours">30.0</field>
        <field
            name="description"
        >Electronic Service Invoice - Integration with city hall for issuing service invoices.</field>
    </record>

    <record id="integration_cnab_receivable" model="budget.integration">
        <field name="name">CNAB Receivables</field>
        <field name="code">cnab_receivable</field>
        <field name="default_hours">50.0</field>
        <field
            name="description"
        >CNAB for Receivables - Banking integration for generating CNAB files for bills and payment control.</field>
    </record>

    <record id="integration_cnab_payable" model="budget.integration">
        <field name="name">CNAB Payables</field>
        <field name="code">cnab_payable</field>
        <field name="default_hours">45.0</field>
        <field
            name="description"
        >CNAB for Payables - Banking integration for generating CNAB files for payments and supplier control.</field>
    </record>

    <record id="integration_sped" model="budget.integration">
        <field name="name">SPED</field>
        <field name="code">sped</field>
        <field name="default_hours">60.0</field>
        <field
            name="description"
        >SPED - Public Digital Bookkeeping System - Generation of SPED Fiscal, SPED Accounting and EFD-ICMS/IPI files.</field>
    </record>

    <record id="integration_ecf" model="budget.integration">
        <field name="name">ECF</field>
        <field name="code">ecf</field>
        <field name="default_hours">35.0</field>
        <field
            name="description"
        >ECF - Fiscal Receipt Printer - Integration with fiscal printers and generation of fiscal receipts.</field>
    </record>

    <record id="integration_sat" model="budget.integration">
        <field name="name">SAT</field>
        <field name="code">sat</field>
        <field name="default_hours">40.0</field>
        <field
            name="description"
        >SAT - Electronic Fiscal Receipt Authenticator and Transmitter - Integration with SAT equipment.</field>
    </record>

    <record id="integration_mde" model="budget.integration">
        <field name="name">MDE</field>
        <field name="code">mde</field>
        <field name="default_hours">25.0</field>
        <field
            name="description"
        >MDE - Electronic Document Manifest - Management of recipient manifestation of electronic invoices.</field>
    </record>

    <record id="integration_edi" model="budget.integration">
        <field name="name">EDI</field>
        <field name="code">edi</field>
        <field name="default_hours">30.0</field>
        <field
            name="description"
        >EDI - Electronic Data Interchange - EDI integration for electronic document exchange with business partners.</field>
    </record>

    <record id="integration_cte" model="budget.integration">
        <field name="name">CT-e</field>
        <field name="code">cte</field>
        <field name="default_hours">45.0</field>
        <field
            name="description"
        >CT-e - Electronic Transport Document - Integration with SEFAZ for issuing and receiving electronic transport documents.</field>
    </record>

    <record id="integration_mdfe" model="budget.integration">
        <field name="name">MDF-e</field>
        <field name="code">mdfe</field>
        <field name="default_hours">50.0</field>
        <field
            name="description"
        >MDF-e - Electronic Fiscal Document Manifest - Integration with SEFAZ for issuing and managing electronic transport fiscal document manifests.</field>
    </record>

    <!-- Modules -->
    <record id="module_sale" model="budget.module">
        <field name="name">Sales</field>
        <field name="code">sale</field>
        <field name="default_hours">20.0</field>
        <field
            name="description"
        >Sales Module - Complete sales process management, including quotations, sales orders, invoices and customer follow-up.</field>
    </record>

    <record id="module_stock" model="budget.module">
        <field name="name">Inventory</field>
        <field name="code">stock</field>
        <field name="default_hours">25.0</field>
        <field
            name="description"
        >Inventory Module - Complete inventory control, movements, transfers between warehouses and product management.</field>
    </record>

    <record id="module_account" model="budget.module">
        <field name="name">Accounting</field>
        <field name="code">account</field>
        <field name="default_hours">30.0</field>
        <field
            name="description"
        >Accounting Module - Complete accounting system with chart of accounts, entries, financial reports and bank reconciliation.</field>
    </record>

    <record id="module_l10n_br_fiscal" model="budget.module">
        <field name="name">Brazilian Fiscal</field>
        <field name="code">l10n_br_fiscal</field>
        <field name="default_hours">35.0</field>
        <field
            name="description"
        >Brazilian Fiscal Module - Fiscal localization for Brazil, including NCM, CFOP, CST, ICMS, IPI, PIS, COFINS and other fiscal obligations.</field>
    </record>

    <record id="module_project" model="budget.module">
        <field name="name">Project</field>
        <field name="code">project</field>
        <field name="default_hours">15.0</field>
