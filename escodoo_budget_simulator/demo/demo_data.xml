    <record id="template_line_migration" model="budget.template.line">
        <field name="template_id" ref="template_standard_implementation" />
        <field name="line_id" ref="line_migration" />
        <field name="sequence">40</field>
    </record>

    <record id="template_line_train" model="budget.template.line">
        <field name="template_id" ref="template_standard_implementation" />
        <field name="line_id" ref="line_training" />
        <field name="sequence">50</field>
    </record>

    <record id="template_line_support" model="budget.template.line">
        <field name="template_id" ref="template_standard_implementation" />
        <field name="line_id" ref="line_support" />
        <field name="sequence">60</field>
    </record>

