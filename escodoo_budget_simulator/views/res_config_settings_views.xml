<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field
            name="name"
        >res.config.settings.view.form.inherit.escodoo_budget_simulator</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('settings')]" position="inside">
                <div
                    class="app_settings_block"
                    data-string="Escodoo Budget Simulator"
                    string="Escodoo Budget Simulator"
                    data-key="escodoo_budget_simulator"
                >
                    <h2>Budget Simulator Settings</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane" />
                            <div class="o_setting_right_pane">
                                <label
                                    for="quotation_product_id"
                                    string="Default Product for Quotations"
                                />
                                <div class="text-muted">
                                    Default product to use when creating sale orders from confirmed budget simulations.
                                </div>
                                <div class="content-group">
                                    <div class="mt16">
                                        <field
                                            name="quotation_product_id"
                                            options="{'no_create': True, 'no_open': True}"
                                        />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
