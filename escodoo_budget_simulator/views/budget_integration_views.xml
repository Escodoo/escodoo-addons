<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_budget_integration_tree" model="ir.ui.view">
        <field name="name">budget.integration.tree</field>
        <field name="model">budget.integration</field>
        <field name="arch" type="xml">
            <tree string="Integrations" decoration-muted="active == False">
                <field name="name" />
                <field name="code" />
                <field name="default_hours" />
                <field name="active" invisible="1" />
            </tree>
        </field>
    </record>

    <record id="view_budget_integration_form" model="ir.ui.view">
        <field name="name">budget.integration.form</field>
        <field name="model">budget.integration</field>
        <field name="arch" type="xml">
            <form string="Integration">
                <sheet>
                    <widget
                        name="web_ribbon"
                        title="Archived"
                        bg_color="bg-danger"
                        attrs="{'invisible': [('active', '=', True)]}"
                    />
                    <!-- Main header -->
                    <div class="oe_title">
                        <label for="name" />
                        <h1><field
                                name="name"
                                placeholder="e.g. Paypal"
                                required="1"
                            /></h1>
                    </div>

                    <group>
                        <group string="General Information">
                            <field name="active" invisible="1" />
                            <field
                                name="code"
                                placeholder="Unique code (e.g., nfe, nfse)"
                            />
                        </group>
                        <group string="Default Hours">
                            <field name="default_hours" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field
                                name="description"
                                placeholder="Description of this integration..."
                            />
                        </page>
                        <page
                            string="Hours formula"
                            groups="escodoo_budget_simulator.group_budget_manager"
                        >
                            <group>
                                <field name="hours_formula" widget="text" />
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_budget_integration_search" model="ir.ui.view">
        <field name="name">budget.integration.search</field>
        <field name="model">budget.integration</field>
        <field name="arch" type="xml">
            <search string="Integrations">
                <field name="name" />
                <field name="code" />
                <filter
                    string="Active"
                    name="active"
                    domain="[('active', '=', True)]"
                />
                <filter
                    string="Archived"
                    name="inactive"
                    domain="[('active', '=', False)]"
                />
            </search>
        </field>
    </record>

    <record id="action_budget_integration" model="ir.actions.act_window">
        <field name="name">Integration Catalog</field>
        <field name="res_model">budget.integration</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_active': 1}</field>
    </record>
</odoo>
