<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_budget_simulation_tree" model="ir.ui.view">
        <field name="name">budget.simulation.tree</field>
        <field name="model">budget.simulation</field>
        <field name="arch" type="xml">
            <tree
                string="Simulations"
                decoration-info="state == 'draft'"
                decoration-success="state == 'confirmed'"
                decoration-warning="state == 'quotation'"
                decoration-muted="state == 'cancelled'"
            >
                <field name="name" />
                <field name="partner_id" />
                <field name="users_qty" />
                <field name="company_qty" />
                <field name="complexity" />
                <field name="total_hours" />
                <field name="sale_order_id" />
                <field
                    name="state"
                    widget="badge"
                    decoration-info="state == 'draft'"
                    decoration-success="state == 'confirmed'"
                    decoration-warning="state == 'quotation'"
                    decoration-muted="state == 'cancelled'"
                />
            </tree>
        </field>
    </record>

    <record id="action_budget_simulation_line" model="ir.actions.act_window">
        <field name="name">Simulation Lines</field>
        <field name="res_model">budget.simulation.line</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('simulation_id', '=', active_id)]</field>
    </record>

    <record id="view_budget_simulation_form" model="ir.ui.view">
        <field name="name">budget.simulation.form</field>
        <field name="model">budget.simulation</field>
        <field name="arch" type="xml">
            <form string="Budget Simulation">
                <header>
                    <!-- Buttons with confirmation when needed and modern icons -->
                    <button
                        name="action_load_from_template"
                        string="Load from Template"
                        type="object"
                        class="oe_highlight"
                        icon="fa-download"
                        confirm="All current simulation data (modules, integrations, and lines) will be deleted and replaced with template data. Do you want to continue?"
                        attrs="{'invisible': ['|', ('state', '!=', 'draft'), ('template_id', '=', False)]}"
                    />

                    <button
                        name="action_create_template_from_simulation"
                        string="Create Template"
                        type="object"
                        icon="fa-file-text"
                        class="btn-secondary"
                    />

                    <button
                        name="action_recalculate"
                        string="Recalculate"
                        type="object"
                        icon="fa-refresh"
                        class="btn-secondary"
                        attrs="{'invisible': [('state', '!=', 'draft')]}"
                    />

                    <button
                        name="action_confirm"
                        string="Confirm"
                        type="object"
                        class="oe_highlight"
                        icon="fa-check"
                        confirm="Are you sure you want to confirm this budget simulation?"
                        attrs="{'invisible': [('state', '!=', 'draft')]}"
                    />

                    <button
                        name="action_set_draft"
                        string="Reset to Draft"
                        type="object"
                        icon="fa-undo"
                        attrs="{'invisible': ['|', ('state', 'not in', ['confirmed', 'quotation', 'cancelled']), ('sale_order_id', '!=', False)]}"
                    />

                    <button
                        name="action_create_quotation"
                        string="Create Quotation"
                        type="object"
                        class="oe_highlight"
                        icon="fa-shopping-cart"
                        attrs="{'invisible': ['|', ('state', '!=', 'confirmed'), ('sale_order_id', '!=', False)]}"
                    />

                    <button
                        name="action_view_quotation"
                        string="View Quotation"
                        type="object"
                        icon="fa-shopping-cart"
                        attrs="{'invisible': [('sale_order_id', '=', False)]}"
                    />

                    <button
                        name="action_cancel"
                        string="Cancel"
                        type="object"
                        icon="fa-times"
                        class="btn-secondary"
                        confirm="Are you sure you want to cancel this simulation? This action cannot be undone."
                        attrs="{'invisible': ['|', ('state', 'in', ['quotation', 'cancelled']), ('sale_order_id', '!=', False)]}"
                    />

                    <field
                        name="state"
                        widget="statusbar"
                        statusbar_visible="draft,confirmed,quotation"
                        clickable="1"
                    />
                </header>

                <sheet>
                    <widget
                        name="web_ribbon"
                        title="Archived"
                        bg_color="bg-danger"
                        attrs="{'invisible': [('active', '=', True)]}"
                    />

                    <!-- Button box with more visible statistics -->
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" icon="fa-clock">
                            <field
                                name="total_hours"
                                string="Total Hours"
                                widget="statinfo"
                                options="{'format': '0.00'}"
                            />
                        </button>
                    </div>

                    <!-- Main header more organized -->
                    <div class="oe_title">
                        <label for="name" />
                        <h1><field
                                name="name"
                                placeholder="e.g. SIM-YYYY-0001"
                                required="1"
                            /></h1>
                    </div>

                    <group>
                        <group string="General Information">
                            <field name="active" invisible="1" />
                            <field name="partner_id" options="{'no_create': True}" />
                            <field name="template_id" options="{'no_create': True}" />
                            <field
                                name="company_id"
                                groups="base.group_multi_company"
                                options="{'no_create': True}"
                            />
                            <field
                                name="date"
                                default_focus="1"
                                placeholder="Simulation date"
                            />
                            <field
                                name="sale_order_id"
                                readonly="1"
                                options="{'no_create': True}"
                                attrs="{'invisible': [('sale_order_id', '=', False)]}"
                            />
                        </group>
                        <group string="Pricing Parameters">
                            <field name="users_qty" string="Number of Users" />
                            <field name="company_qty" string="Number of Companies" />
                            <field
                                name="complexity"
                                widget="radio"
                                options="{'horizontal': True}"
                            />
                        </group>
                    </group>

                    <notebook>
                        <page string="Description">
                            <field
                                name="description"
                                placeholder="Description of this budget simulation..."
                            />
                        </page>
                        <!-- Page 1: Modules and Integrations (better layout) -->
                        <page string="Modules" name="modules">
                            <field name="module_line_ids" nolabel="1">
                                <tree editable="bottom">
                                    <field name="sequence" widget="handle" />
                                    <field name="module_id" widget="link_to_record" />
                                    <field name="description" />
                                    <field name="default_hours" sum="Default" />
                                    <field name="adjusted_hours" sum="Adjusted" />
                                    <field
                                        name="final_hours"
                                        readonly="1"
                                        sum="Total Hours"
                                    />
                                </tree>
                                <form>
                                    <sheet>
                                        <group>
                                            <group>
                                                <field
                                                    name="module_id"
                                                    options="{'no_create': True}"
                                                />
                                                <field
                                                    name="default_hours"
                                                    readonly="1"
                                                />
                                            </group>
                                            <group>
                                                <field name="adjusted_hours" />
                                                <field
                                                    name="final_hours"
                                                    readonly="1"
                                                />
                                            </group>
                                        </group>
                                    </sheet>
                                </form>
                            </field>
                        </page>
                        <page string="Integrations" name="integrations">
                            <field name="integration_line_ids" nolabel="1">
                                <tree editable="bottom">
                                    <field name="sequence" widget="handle" />
                                    <field
                                        name="integration_id"
                                        widget="link_to_record"
                                    />
                                    <field name="description" />
                                    <field name="default_hours" sum="Default" />
                                    <field name="adjusted_hours" sum="Adjusted" />
                                    <field
                                        name="final_hours"
                                        readonly="1"
                                        sum="Total Hours"
                                    />
                                </tree>
                                <form>
                                    <sheet>
                                        <group>
                                            <group>
                                                <field
                                                    name="integration_id"
                                                    options="{'no_create': True}"
                                                />
                                                <field
                                                    name="default_hours"
                                                    readonly="1"
                                                />
                                            </group>
                                            <group>
                                                <field name="adjusted_hours" />
                                                <field
                                                    name="final_hours"
                                                    readonly="1"
                                                />
                                            </group>
                                        </group>
                                    </sheet>
                                </form>
                            </field>
                        </page>

                        <!-- Page 2: General Activities -->
                        <page string="General Activities">
                            <field name="line_ids" nolabel="1">
                                <tree editable="bottom">
                                    <field name="sequence" widget="handle" />
                                    <field name="line_id" widget="link_to_record" />
                                    <field name="description" />
                                    <field name="default_hours" sum="Base" />
                                    <field name="adjusted_hours" sum="Adjusted" />
                                    <field
                                        name="final_hours"
                                        readonly="1"
                                        sum="Total Hours"
                                    />
                                </tree>

                                <form>
                                    <sheet>
                                        <group>
                                            <group>
                                                <field name="sequence" invisible="1" />
                                                <field
                                                    name="line_id"
                                                    options="{'no_create': True}"
                                                />
                                                <field name="name" required="1" />
                                                <field name="category" />
                                            </group>
                                            <group>
                                                <field name="default_hours" />
                                                <field name="adjusted_hours" />
                                                <field
                                                    name="final_hours"
                                                    readonly="1"
                                                />
                                            </group>
                                        </group>
                                        <notebook>
                                            <page string="Description">
                                                <field
                                                    name="description"
                                                    placeholder="Detailed description of this activitie..."
                                                />
                                            </page>
                                        </notebook>
                                    </sheet>
                                </form>
                            </field>
                        </page>

                        <!-- Page 3: Internal Notes -->
                        <page string="Internal Notes">
                            <field
                                name="notes"
                                placeholder="Add any internal comments, justifications, risks, assumptions..."
                            />
                        </page>
                    </notebook>

                    <!-- Totals Section -->
                    <group name="budget_totals" col="6" class="mt-2 mt-md-0">
                        <group colspan="4">
                            <div />
                        </group>
                        <group
                            class="oe_subtotal_footer oe_right"
                            colspan="2"
                            name="simulation_total"
                        >
                            <table class="o_group o_inner_group o_group_col_12">
                                <tr>
                                    <td class="o_td_label">
                                        <label
                                            for="total_hours"
                                            string="Total Hours:"
                                        />
                                    </td>
                                    <td style="width: 50%;" class="text-end">
                                        <field
                                            name="total_hours"
                                            widget="float"
                                            nolabel="1"
                                            readonly="1"
                                            options="{'format': '0.00'}"
                                        />
                                    </td>
                                </tr>
                            </table>
                        </group>
                        <div class="clearfix" />
                    </group>
                </sheet>

                <!-- Chatter with more natural position -->
                <div class="oe_chatter">
                    <field name="message_follower_ids" />
                    <field name="activity_ids" />
                    <field name="message_ids" />
                </div>
            </form>
        </field>
    </record>

    <record id="view_budget_simulation_search" model="ir.ui.view">
        <field name="name">budget.simulation.search</field>
        <field name="model">budget.simulation</field>
        <field name="arch" type="xml">
            <search string="Simulations">
                <field name="name" />
                <field name="partner_id" />
                <filter
                    string="Draft"
                    name="draft"
                    domain="[('state', '=', 'draft')]"
                />
                <filter
                    string="Confirmed"
                    name="confirmed"
                    domain="[('state', '=', 'confirmed')]"
                />
                <filter
                    string="Quotation Created"
                    name="quotation"
                    domain="[('state', '=', 'quotation')]"
                />
                <filter
                    string="Cancelled"
                    name="cancelled"
                    domain="[('state', '=', 'cancelled')]"
                />
                <separator />
                <filter
                    string="Low Complexity"
                    name="low"
                    domain="[('complexity', '=', 'low')]"
                />
                <filter
                    string="Medium Complexity"
                    name="medium"
                    domain="[('complexity', '=', 'medium')]"
                />
                <filter
                    string="High Complexity"
                    name="high"
                    domain="[('complexity', '=', 'high')]"
                />
                <group expand="0" string="Group By">
                    <filter
                        string="State"
                        name="group_state"
                        context="{'group_by': 'state'}"
                    />
                    <filter
                        string="Partner"
                        name="group_partner"
                        context="{'group_by': 'partner_id'}"
                    />
                    <filter
                        string="Complexity"
                        name="group_complexity"
                        context="{'group_by': 'complexity'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="action_budget_simulation" model="ir.actions.act_window">
        <field name="name">Simulations</field>
        <field name="res_model">budget.simulation</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first budget simulation!
            </p>
            <p>
                Budget simulations help you estimate hours and costs for Odoo implementations.
            </p>
        </field>
    </record>
</odoo>
