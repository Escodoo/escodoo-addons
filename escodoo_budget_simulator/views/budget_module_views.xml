<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_budget_module_tree" model="ir.ui.view">
        <field name="name">budget.module.tree</field>
        <field name="model">budget.module</field>
        <field name="arch" type="xml">
            <tree string="Modules" decoration-muted="active == False">
                <field name="name" />
                <field name="code" />
                <field name="default_hours" />
                <field name="active" invisible="1" />
            </tree>
        </field>
    </record>

    <record id="view_budget_module_form" model="ir.ui.view">
        <field name="name">budget.module.form</field>
        <field name="model">budget.module</field>
        <field name="arch" type="xml">
            <form string="Module">
                <sheet>
                    <widget
                        name="web_ribbon"
                        title="Archived"
                        bg_color="bg-danger"
                        attrs="{'invisible': [('active', '=', True)]}"
                    />

                    <!-- Main header -->
                    <div class="oe_title">
                        <label for="name" />
                        <h1>
                            <field
                                name="name"
                                placeholder="e.g. Account"
                                required="1"
                            />
                        </h1>
                    </div>

                    <group>
                        <group string="General Information">
                            <field name="active" invisible="1" />
                            <field
                                name="code"
                                placeholder="Odoo module code (e.g., sale, stock)"
                            />
                        </group>
                        <group string="Default Hours">
                            <field name="default_hours" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field
                                name="description"
                                placeholder="Description of this module..."
                            />
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_budget_module_search" model="ir.ui.view">
        <field name="name">budget.module.search</field>
        <field name="model">budget.module</field>
        <field name="arch" type="xml">
            <search string="Modules">
                <field name="name" />
                <field name="code" />
                <filter
                    string="Active"
                    name="active"
                    domain="[('active', '=', True)]"
                />
                <filter
                    string="Archived"
                    name="inactive"
                    domain="[('active', '=', False)]"
                />
            </search>
        </field>
    </record>

    <record id="action_budget_module" model="ir.actions.act_window">
        <field name="name">Module Catalog</field>
        <field name="res_model">budget.module</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_active': 1}</field>
    </record>
</odoo>
