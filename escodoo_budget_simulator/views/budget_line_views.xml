<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_budget_line_tree" model="ir.ui.view">
        <field name="name">budget.line.tree</field>
        <field name="model">budget.line</field>
        <field name="arch" type="xml">
            <tree string="Activities" decoration-muted="active == False">
                <field name="sequence" widget="handle" />
                <field name="name" />
                <field name="code" />
                <field name="category" />
                <field name="default_hours" />
                <field name="active" invisible="1" />
            </tree>
        </field>
    </record>

    <record id="view_budget_line_form" model="ir.ui.view">
        <field name="name">budget.line.form</field>
        <field name="model">budget.line</field>
        <field name="arch" type="xml">
            <form string="Activitie">
                <sheet>
                    <widget
                        name="web_ribbon"
                        title="Archived"
                        bg_color="bg-danger"
                        attrs="{'invisible': [('active', '=', True)]}"
                    />

                    <!-- Main header -->
                    <div class="oe_title">
                        <label for="name" />
                        <h1>
                            <field
                                name="name"
                                placeholder="e.g. Discovery Analysis"
                                required="1"
                            />
                        </h1>
                    </div>

                    <group>
                        <group string="General Information">
                            <field name="active" invisible="1" />
                            <field
                                name="code"
                                placeholder="Unique code (e.g., discovery_analysis)"
                            />
                            <field name="category" />
                        </group>
                        <group string="Default Hours">
                            <field name="default_hours" />
                        </group>
                    </group>

                    <notebook>
                        <page string="Description">
                            <field
                                name="description"
                                placeholder="Description of this activitie..."
                            />
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_budget_line_search" model="ir.ui.view">
        <field name="name">budget.line.search</field>
        <field name="model">budget.line</field>
        <field name="arch" type="xml">
            <search string="Activities">
                <field name="name" />
                <field name="code" />
                <field name="category" />
                <filter
                    string="Active"
                    name="active"
                    domain="[('active', '=', True)]"
                />
                <filter
                    string="Archived"
                    name="inactive"
                    domain="[('active', '=', False)]"
                />
                <separator />
                <filter
                    string="Discovery"
                    name="discovery"
                    domain="[('category', '=', 'discovery')]"
                />
                <filter
                    string="Configuration"
                    name="config"
                    domain="[('category', '=', 'config')]"
                />
                <filter
                    string="Development"
                    name="dev"
                    domain="[('category', '=', 'dev')]"
                />
                <filter
                    string="Training"
                    name="train"
                    domain="[('category', '=', 'train')]"
                />
            </search>
        </field>
    </record>

    <record id="action_budget_line" model="ir.actions.act_window">
        <field name="name">General Activitie Catalog</field>
        <field name="res_model">budget.line</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_active': 1}</field>
    </record>
</odoo>
