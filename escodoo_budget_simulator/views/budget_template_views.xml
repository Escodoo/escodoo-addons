<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_budget_template_tree" model="ir.ui.view">
        <field name="name">budget.template.tree</field>
        <field name="model">budget.template</field>
        <field name="arch" type="xml">
            <tree
                string="Templates"
                decoration-info="state == 'draft'"
                decoration-success="state == 'confirmed'"
            >
                <field name="name" />
                <field name="complexity" />
                <field name="users_qty" />
                <field name="company_qty" />
                <field name="total_hours" />
                <field
                    name="state"
                    widget="badge"
                    decoration-info="state == 'draft'"
                    decoration-success="state == 'confirmed'"
                />
            </tree>
        </field>
    </record>

    <record id="view_budget_template_form" model="ir.ui.view">
        <field name="name">budget.template.form</field>
        <field name="model">budget.template</field>
        <field name="arch" type="xml">
            <form string="Budget Template">
                <header>
                    <button
                        name="action_recalculate"
                        string="Recalculate"
                        type="object"
                        icon="fa-refresh"
                        class="btn-secondary"
                        attrs="{'invisible': [('state', '!=', 'draft')]}"
                    />

                    <button
                        name="action_confirm"
                        string="Confirm"
                        type="object"
                        class="oe_highlight"
                        icon="fa-check"
                        confirm="Are you sure you want to confirm this budget template?"
                        attrs="{'invisible': [('state', '!=', 'draft')]}"
                    />

                    <button
                        name="action_set_draft"
                        string="Reset to Draft"
                        type="object"
                        icon="fa-undo"
                        attrs="{'invisible': [('state', '!=', 'confirmed')]}"
                    />

                    <field
                        name="state"
                        widget="statusbar"
                        statusbar_visible="draft,confirmed"
                        clickable="1"
                    />
                </header>
                <sheet>
                    <widget
                        name="web_ribbon"
                        title="Archived"
                        bg_color="bg-danger"
                        attrs="{'invisible': [('active', '=', True)]}"
                    />

                    <!-- Button box with total hours -->
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" icon="fa-clock">
                            <field
                                name="total_hours"
                                string="Total Hours"
                                widget="statinfo"
                                options="{'format': '0.00'}"
                            />
                        </button>
                    </div>

                    <!-- Main header -->
                    <div class="oe_title">
                        <label for="name" />
                        <h1><field
                                name="name"
                                placeholder="e.g. Template name..."
                                required="1"
                            /></h1>
                    </div>

                    <group>
                        <group string="General Information">
                            <field name="active" invisible="1" />
                            <field
                                name="complexity"
                                widget="radio"
                                options="{'horizontal': True}"
                            />
                            <field name="users_qty" string="Number of Users" />
                            <field name="company_qty" string="Number of Companies" />
                        </group>
                    </group>

                    <notebook>
                        <page string="Description">
                            <field
                                name="description"
                                placeholder="Template description..."
                            />
                        </page>
                        <page string="Modules" name="modules">
                            <field name="module_line_ids" nolabel="1">
                                <tree editable="bottom">
                                    <field name="sequence" widget="handle" />
                                    <field name="module_id" widget="link_to_record" />
                                    <field name="description" />
                                    <field name="default_hours" sum="Default" />
                                    <field name="adjusted_hours" sum="Adjusted" />
                                    <field
                                        name="final_hours"
                                        readonly="1"
                                        sum="Total Hours"
                                    />
                                </tree>
                                <form>
                                    <sheet>
                                        <group>
                                            <group>
                                                <field
                                                    name="module_id"
                                                    options="{'no_create': True}"
                                                />
                                                <field
                                                    name="default_hours"
                                                    readonly="1"
                                                />
                                            </group>
                                            <group>
                                                <field name="adjusted_hours" />
                                                <field
                                                    name="final_hours"
                                                    readonly="1"
                                                />
                                            </group>
                                        </group>
                                    </sheet>
                                </form>
                            </field>
                        </page>
                        <page string="Integrations" name="integrations">
                            <field name="integration_line_ids" nolabel="1">
                                <tree editable="bottom">
                                    <field name="sequence" widget="handle" />
                                    <field
                                        name="integration_id"
                                        widget="link_to_record"
                                    />
                                    <field name="description" />
                                    <field name="default_hours" sum="Default" />
                                    <field name="adjusted_hours" sum="Adjusted" />
                                    <field
                                        name="final_hours"
                                        readonly="1"
                                        sum="Total Hours"
                                    />
                                </tree>
                                <form>
                                    <sheet>
                                        <group>
                                            <group>
                                                <field
                                                    name="integration_id"
                                                    options="{'no_create': True}"
                                                />
                                                <field
                                                    name="default_hours"
                                                    readonly="1"
                                                />
                                            </group>
                                            <group>
                                                <field name="adjusted_hours" />
                                                <field
                                                    name="final_hours"
                                                    readonly="1"
                                                />
                                            </group>
                                        </group>
                                    </sheet>
                                </form>
                            </field>
                        </page>

                        <page string="General Activities" name="template_lines">
                            <field name="line_ids" nolabel="1">
                                <tree editable="bottom">
                                    <field name="sequence" widget="handle" />
                                    <field name="line_id" widget="link_to_record" />
                                    <field name="description" />
                                    <field name="default_hours" sum="Default" />
                                    <field name="adjusted_hours" sum="Adjusted" />
                                    <field
                                        name="final_hours"
                                        readonly="1"
                                        sum="Total Hours"
                                    />
                                </tree>
                                <form>
                                    <sheet>
                                        <group>
                                            <group>
                                                <field name="sequence" invisible="1" />
                                                <field
                                                    name="line_id"
                                                    options="{'no_create': True}"
                                                />
                                                <field name="name" required="1" />
                                                <field name="category" />
                                            </group>
                                            <group>
                                                <field name="default_hours" />
                                                <field name="adjusted_hours" />
                                                <field
                                                    name="final_hours"
                                                    readonly="1"
                                                />
                                            </group>
                                        </group>
                                        <notebook>
                                            <page string="Description">
                                                <field
                                                    name="description"
                                                    placeholder="Activitie description..."
                                                />
                                            </page>
                                        </notebook>
                                    </sheet>
                                </form>
                            </field>
                        </page>
                    </notebook>

                    <!-- Totals Section -->
                    <group name="budget_totals" col="6" class="mt-2 mt-md-0">
                        <group colspan="4">
                            <div />
                        </group>
                        <group
                            class="oe_subtotal_footer oe_right"
                            colspan="2"
                            name="simulation_total"
                        >
                            <table class="o_group o_inner_group o_group_col_12">
                                <tr>
                                    <td class="o_td_label">
                                        <label
                                            for="total_hours"
                                            string="Total Hours:"
                                        />
                                    </td>
                                    <td style="width: 50%;" class="text-end">
                                        <field
                                            name="total_hours"
                                            widget="float"
                                            nolabel="1"
                                            readonly="1"
                                            options="{'format': '0.00'}"
                                        />
                                    </td>
                                </tr>
                            </table>
                        </group>
                        <div class="clearfix" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_budget_template_search" model="ir.ui.view">
        <field name="name">budget.template.search</field>
        <field name="model">budget.template</field>
        <field name="arch" type="xml">
            <search string="Templates">
                <field name="name" />
                <filter
                    string="Active"
                    name="active"
                    domain="[('active', '=', True)]"
                />
                <filter
                    string="Archived"
                    name="inactive"
                    domain="[('active', '=', False)]"
                />
            </search>
        </field>
    </record>

    <record id="action_budget_template" model="ir.actions.act_window">
        <field name="name">Templates</field>
        <field name="res_model">budget.template</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_active': 1}</field>
    </record>
</odoo>
