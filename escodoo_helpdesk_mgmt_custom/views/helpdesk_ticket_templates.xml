            <attribute
                name="groups"
            >helpdesk_mgmt.group_helpdesk_user_own,escodoo_helpdesk_mgmt_custom.group_helpdesk_mgmt_portal_create_ticket</attribute>
        </xpath>
    </template>

    <template
        id="portal_my_tickets"
        inherit_id="helpdesk_mgmt.portal_my_tickets"
