<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="helpdesk_ticket_environment_change_form" model="ir.ui.view">
        <field name="name">helpdesk.ticket.environment.change.form</field>
        <field name="model">helpdesk.ticket</field>
        <field name="inherit_id" ref="helpdesk_mgmt.ticket_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button
                    name="action_request_environment_change"
                    type="object"
                    string="Request environment update"
                    groups="helpdesk_mgmt.group_helpdesk_user_own"
                />
            </xpath>
        </field>
    </record>
</odoo>
