<?xml version="1.0" encoding="utf-8" ?>
<odoo><data noupdate="1">

    <!--
        12 perguntas de certificação do curso Boardkit.
        Cobertura:
        Q1  → Lição 1.1 (visão geral)
        Q2  → Lição 2.1 (CRM Pipeline)
        Q3  → Lição 3.1 (filtros)
        Q4  → Lição 4.4 (aba Value)
        Q5  → Lição 4.5 (aba Chart)
        Q6  → Lição 4.7 (drill down)
        Q7  → Lição 4.8 (domain)
        Q8  → Lição 5.1 (reorganização)
        Q9  → Lição 6.1 (templates)
        Q10 → Lição 7.1 (settings/paletas)
        Q11 → Lição 9.1 (erros comuns)
        Q12 → Quiz Final 12.1/12.2 (calibragem Suporte Escodoo)

        Linguagem user-facing (sem CLI/deploy/install técnico).
        Cada pergunta = simple_choice com 4 opções, 1 correta.
    -->

    <!-- Q1 - Lição 1.1 -->
    <record id="survey_q_cert_01" model="survey.question">
        <field name="survey_id" ref="survey_certification_boardkit" />
        <field
                name="title"
            >Qual é o principal diferencial do boardkit em relação aos dashboards nativos do Odoo?</field>
        <field name="question_type">simple_choice</field>
        <field name="sequence">10</field>
        <field name="answer_score">1.0</field>
    </record>
    <record id="survey_a_cert_01_a" model="survey.question.answer">
        <field name="question_id" ref="survey_q_cert_01" />
        <field
                name="value"
            >Substitui todos os módulos padrão do Odoo, eliminando a necessidade de personalização.</field>
        <field name="is_correct" eval="False" />
        <field name="answer_score" eval="-0.25" />
        <field name="sequence">1</field>
    </record>
    <record id="survey_a_cert_01_b" model="survey.question.answer">
        <field name="question_id" ref="survey_q_cert_01" />
        <field
                name="value"
            >Permite criar dashboards analíticos configuráveis, sem código, reaproveitando dados que já existem no Odoo.</field>
        <field name="is_correct" eval="True" />
        <field name="answer_score" eval="1.0" />
        <field name="sequence">2</field>
    </record>
    <record id="survey_a_cert_01_c" model="survey.question.answer">
        <field name="question_id" ref="survey_q_cert_01" />
        <field
                name="value"
            >É uma ferramenta externa que conecta ao Odoo via API.</field>
        <field name="is_correct" eval="False" />
        <field name="answer_score" eval="-0.25" />
        <field name="sequence">3</field>
    </record>
    <record id="survey_a_cert_01_d" model="survey.question.answer">
        <field name="question_id" ref="survey_q_cert_01" />
        <field
                name="value"
            >Só funciona com módulos customizados — não lê dados nativos.</field>
        <field name="is_correct" eval="False" />
        <field name="answer_score" eval="-0.25" />
        <field name="sequence">4</field>
    </record>

