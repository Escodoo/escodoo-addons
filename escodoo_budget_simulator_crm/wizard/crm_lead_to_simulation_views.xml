<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="crm_lead_to_simulation_view_form" model="ir.ui.view">
        <field name="name">crm.lead.to.simulation.view.form</field>
        <field name="model">crm.lead.to.simulation</field>
        <field name="arch" type="xml">
            <form string="Create Budget Simulation">
                <group>
                    <group>
                        <field name="action" widget="radio" />
                        <field name="lead_id" invisible="1" />
                    </group>
                </group>
                <group invisible="action != 'exist'">
                    <group>
                        <field
                            name="partner_id"
                            invisible="action != 'exist'"
                            required="action == 'exist'"
                            context="{'res_partner_search_mode': 'customer'}"
                        />
                    </group>
                </group>
                <footer>
                    <button
                        name="action_apply"
                        string="Confirm"
                        type="object"
                        class="btn-primary"
                    />
                    <button string="Cancel" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record id="crm_lead_to_simulation_action" model="ir.actions.act_window">
        <field name="name">Create Budget Simulation</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">crm.lead.to.simulation</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="crm_lead_to_simulation_view_form" />
        <field name="target">new</field>
    </record>
</odoo>
